NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
# Legacy env fallback admin (still supported if database admin users are not set up yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$xxxxx
JWT_SECRET=your-random-secret-string-at-least-32-characters-long

# --- Quen mat khau (gui link dat lai qua email) ---
# Gmail: bat xac minh 2 buoc, tao "Mat khau ung dung" tai https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=HTX Tan Phu <your-gmail@gmail.com>
# Email chu website: nhan link dat lai cho tai khoan chua luu email rieng (vd: tai khoan admin env)
ADMIN_RECOVERY_EMAIL=your-gmail@gmail.com
# Tuy chon: goc URL dung trong link email. Production mac dinh dung SITE_URL trong src/lib/seo.ts
# PASSWORD_RESET_BASE_URL=https://www.htxtanphu.com
