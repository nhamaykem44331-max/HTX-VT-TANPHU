NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
# Env admin (used only if the username has no row in admin_users). No default password:
# leave ADMIN_PASSWORD_HASH empty and env login is disabled entirely.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$xxxxx
JWT_SECRET=your-random-secret-string-at-least-32-characters-long
